# Phantom Chat — Environment Variables
# Copy to .env and fill in values. NEVER commit .env

APP_HOST=127.0.0.1
APP_PORT=8000
SESSION_TTL_MINUTES=30
MAX_SESSION_PARTICIPANTS=2
MAX_PAYLOAD_BYTES=65536
RATE_LIMIT_PER_MINUTE=10
LOG_LEVEL=WARNING
# Required — no default. Set to your actual domain.
# For local dev, comma-separate both ports (direct uvicorn + Caddy dev proxy):
# ALLOWED_ORIGIN=http://localhost:8000,http://localhost:8080
# For production, use only your domain:
ALLOWED_ORIGIN=https://your-domain.example.com
